{% block moorl_parts_list_accessory_list %}
    {% for accessoryList in accessoryLists %}
        {% block moorl_parts_list_accessory_list_title %}
            {% if accessoryList.title %}
                <legend class="h4">{{ accessoryList.title }}</legend>
            {% endif %}
        {% endblock %}

        {% block moorl_parts_list_accessory_list_items %}
            {% sw_include '@MoorlFoundation/plugin/moorl-foundation/component/parts-list/index.html.twig' with {
                items: accessoryList.items,
                namePrefix: namePrefix,
                options: options
            } %}
        {% endblock %}
    {% endfor %}
{% endblock %}