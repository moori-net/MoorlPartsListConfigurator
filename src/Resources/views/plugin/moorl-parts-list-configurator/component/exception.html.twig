{% block moorl_parts_list_exception %}
    {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
        type: "danger",
        content: content ?: "moorl-parts-list-configurator.calculatedPartsListError"|trans|sw_sanitize
    } %}
    <div class="d-none">{{ exception.message }}</div>
{% endblock %}