{% block moorl_parts_list_layout_demo_fence_2 %}
    {% set totalLengthLabel = 'moorl-parts-list-configurator.logical-configurator.field.totalLength'|trans %}
    {% set unitM = 'moorl-parts-list-configurator.logical-configurator.unit.m'|trans %}

    <div
            class="js-summary-group"
            id="{{ totalLengthLabel|slug }}"
            data-name="{{ totalLengthLabel }}"
            data-unit="{{ unitM }}">
        {% block moorl_parts_list_layout_demo_fence_2_elements %}
            {% for element in logicalConfigurator.elements %}
                {% set elementLabel = 'moorl-parts-list-configurator.logical-configurator.field.' ~ element %}

                {% block moorl_parts_list_layout_demo_fence_2_element %}
                    <div
                            class="row my-3 js-summary-item"
                            data-name="{{ elementLabel|trans }}">
                        {% block moorl_parts_list_layout_demo_fence_2_element_title %}
                            <div class="col-3 col-md-2 product-detail-configurator-group-title">
                                {{ elementLabel|trans }}
                            </div>
                        {% endblock %}

                        {% block moorl_parts_list_layout_demo_fence_2_element_length %}
                            <div class="col-9 col-md-7">
                                <div class="input-group mb-2">
                                    {% block moorl_parts_list_layout_demo_fence_2_element_length_label %}
                                        <label
                                                class="input-group-text"
                                                for="{{ element }}_length">
                                            {{ "moorl-parts-list-configurator.logical-configurator.field.partLength"|trans }}
                                        </label>
                                    {% endblock %}

                                    {% block moorl_parts_list_layout_demo_fence_2_element_length_input %}
                                        <input
                                                class="form-control"
                                                type="number"
                                                name="{{ element }}_length"
                                                id="{{ element }}_length"
                                                min="2.5"
                                                value="5"
                                                step="0.5"
                                        />
                                    {% endblock %}

                                    {% block moorl_parts_list_layout_demo_fence_2_element_length_unit %}
                                        <span class="input-group-text">
                                            {{ "moorl-parts-list-configurator.logical-configurator.unit.m"|trans }}
                                        </span>
                                    {% endblock %}
                                </div>
                            </div>
                        {% endblock %}
                    </div>
                {% endblock %}
            {% endfor %}
        {% endblock %}
    </div>
{% endblock %}