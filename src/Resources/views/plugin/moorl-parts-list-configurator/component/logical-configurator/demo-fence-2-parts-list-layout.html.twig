<div
        class="js-summary-group"
        id="{{ "moorl-parts-list-configurator.logical-configurator.field.totalLength"|trans|slug }}"
        data-name="{{ "moorl-parts-list-configurator.logical-configurator.field.totalLength"|trans }}"
        data-unit="{{ "moorl-parts-list-configurator.logical-configurator.unit.m"|trans }}"
>
    {% for element in logicalConfigurator.elements %}
        <div
                class="row my-3 js-summary-item"
                data-name="{{ "moorl-parts-list-configurator.logical-configurator.field.#{element}"|trans }}"
        >
            <div class="col-3 col-md-2 product-detail-configurator-group-title">
                {{ "moorl-parts-list-configurator.logical-configurator.field.#{element}"|trans }}
            </div>

            <div class="col-9 col-md-7">
                <div class="input-group mb-2">
                    <label for="{{ element }}_length" class="input-group-text">
                        {{ "moorl-parts-list-configurator.logical-configurator.field.partLength"|trans }}
                    </label>
                    <input
                            class="form-control"
                            type="number"
                            name="{{ element }}_length"
                            id="{{ element }}_length"
                            min="2.5"
                            value="5"
                            step="0.5"
                    />
                    <span class="input-group-text">
                                    {{ "moorl-parts-list-configurator.logical-configurator.unit.m"|trans }}
                                </span>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
